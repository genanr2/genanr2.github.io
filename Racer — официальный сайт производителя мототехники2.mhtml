@charset "utf-8";

:root { --ease: cubic-bezier(.2, .7, .2, 1); --ease-menu: cubic-bezier(.2, =
.8, .2, 1); }

html { scroll-behavior: smooth; }

::selection { background: rgb(227, 30, 36); color: rgb(255, 255, 255); }

.wrap { padding-left: clamp(20px, 4.5vw, 64px); padding-right: clamp(20px, =
4.5vw, 64px); }

.logo-img { filter: brightness(0) invert(1); }

.text-ghost { color: transparent; -webkit-text-stroke: 1px rgba(255, 255, 2=
55, 0.35); }

.text-ghost--dark { color: transparent; -webkit-text-stroke: 1px rgba(16, 1=
7, 20, 0.14); }

.skew-btn { display: block; transform: skewX(-12deg); cursor: pointer; tran=
sition: background .2s var(--ease), color .2s var(--ease), border-color .2s=
 var(--ease); }

.skew-btn > span { display: flex; align-items: center; gap: 8px; transform:=
 skewX(12deg); font-weight: 700; font-size: 12px; letter-spacing: 0.08em; t=
ext-transform: uppercase; white-space: nowrap; }

.megamenu { opacity: 0; pointer-events: none; transform: translateY(-10px);=
 transition: opacity .25s var(--ease), transform .25s var(--ease); }

.megamenu.is-open { opacity: 1; pointer-events: auto; transform: translateY=
(0px); }

#nav-catalog-toggle .chev { transition: transform .25s var(--ease); }

#nav-catalog-toggle.is-open .chev { transform: rotate(180deg); }

.mobmenu { transform: translateX(105%); transition: transform .38s var(--ea=
se-menu); }

.mobmenu.is-open { transform: translateX(0px); }

.mobmenu .anim-in { opacity: 0; transform: translateX(24px); transition-pro=
perty: ; transition-duration: ; transition-timing-function: ; transition-be=
havior: ; transition-delay: var(--d, 0s); }

.mobmenu.is-open .anim-in { opacity: 1; transform: translateX(0px); }

.modal { opacity: 0; pointer-events: none; transition: opacity .28s var(--e=
ase); }

.modal.is-open { opacity: 1; pointer-events: auto; }

.modal .modal-panel { transform: translateY(16px) scale(0.97); transition: =
transform .32s var(--ease); }

.modal.is-open .modal-panel { transform: translateY(0px) scale(1); }

.modal-ty { opacity: 0; pointer-events: none; transition: opacity .3s var(-=
-ease); }

.modal-ty.is-visible { opacity: 1; pointer-events: auto; }

.lightbox { opacity: 0; pointer-events: none; transition: opacity .3s var(-=
-ease); }

.lightbox.is-open { opacity: 1; pointer-events: auto; }

.lightbox img { transform: scale(0.96); transition: transform .3s var(--eas=
e), opacity .2s var(--ease); }

.lightbox.is-open img { transform: scale(1); }

.lightbox img.is-swapping { opacity: 0; }

[data-reveal] { opacity: 0; transform: translateY(26px); transition-propert=
y: ; transition-duration: ; transition-timing-function: ; transition-behavi=
or: ; transition-delay: var(--d, 0s); will-change: opacity, transform; }

[data-reveal=3D"left"] { transform: translateX(-30px); }

[data-reveal=3D"right"] { transform: translateX(30px); }

[data-reveal=3D"zoom"] { transform: scale(0.96); }

[data-reveal].is-in { opacity: 1; transform: none; }

@keyframes pageIn {=20
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: none; }
}

main { animation: pageIn .5s var(--ease) both; }

body.page-leave { opacity: 0; transition: opacity 0.18s; }

@keyframes heroDrift {=20
  0% { transform: scale(1.04); }
  100% { transform: scale(1); }
}

.hero-drift { animation: heroDrift 14s var(--ease) both; }

@keyframes cardIn {=20
  0% { opacity: 0; transform: translateY(14px); }
  100% { opacity: 1; transform: none; }
}

.re-anim > * { animation: cardIn .45s var(--ease) backwards; }

.img-fade { opacity: 0; transition: opacity .5s var(--ease); }

.img-fade.is-loaded { opacity: 1; }

.spinner { width: 44px; height: 44px; border-width: 4px; border-style: soli=
d; border-color: rgb(227, 30, 36) rgba(16, 17, 20, 0.15) rgba(16, 17, 20, 0=
.15); border-image: none; border-radius: 50%; animation: 0.9s linear 0s inf=
inite normal none running spin; margin: 40px auto; }

.spinner--light { border-color: rgb(255, 255, 255) rgba(255, 255, 255, 0.2)=
 rgba(255, 255, 255, 0.2); }

@keyframes spin {=20
  100% { transform: rotate(360deg); }
}

.skel { background: linear-gradient(100deg, rgb(244, 243, 241) 40%, rgb(255=
, 255, 255) 50%, rgb(244, 243, 241) 60%) 0% 0% / 200% 100%; animation: 1.4s=
 ease 0s infinite normal none running skel; }

@keyframes skel {=20
  100% { background-position: -200% 0px; }
}

.map-grayscale [class*=3D"ground-pane"] { filter: grayscale(1); }

.map-info { opacity: 0; transform: translateY(14px); pointer-events: none; =
transition: opacity .3s var(--ease), transform .3s var(--ease); }

.map-info.is-open { opacity: 1; transform: none; pointer-events: auto; }

.cookiebar { opacity: 0; transform: translateY(24px); pointer-events: none;=
 transition: opacity .45s var(--ease), transform .45s var(--ease); }

.cookiebar.is-open { opacity: 1; transform: none; pointer-events: auto; }

.news-slide { opacity: 0; pointer-events: none; transition: opacity .8s var=
(--ease); }

.news-slide.is-active { opacity: 1; pointer-events: auto; }

.news-dot { transition: background .25s var(--ease), width .25s var(--ease)=
; }

.ck-host { font-size: 14px; line-height: 1.7; overflow-x: auto; }

.ck-host table { border-collapse: collapse; width: 100%; max-width: 720px; =
}

.ck-host td { padding: 6px 12px 6px 0px; vertical-align: top; }

.ck-host h1 { font-size: clamp(20px, 2vw, 26px); text-transform: uppercase;=
 font-weight: 800; margin: 26px 0px 10px; }

.ck-host h2 { font-size: clamp(18px, 1.8vw, 22px); font-weight: 800; margin=
: 22px 0px 8px; }

.ck-host a { color: rgb(227, 30, 36); }

.ck-host p { margin: 6px 0px; }

.ck-host img { max-width: 100%; height: auto; }

.ck-host figure { margin: 14px 0px; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, ::before, ::after { animation-duration: 0.01ms !important; animation-i=
teration-count: 1 !important; transition-duration: 0.01ms !important; }
  [data-reveal] { opacity: 1; transform: none; }
}
