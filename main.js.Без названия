/* ------------------------------------------------------------
   Карта дилеров (Яндекс.Карты, фирменный стиль):
   ч/б подложка, свои метки, инфо-блок снизу слева по клику.
   Контейнер: <div id="..."> внутри блока-обёртки, рядом .map-info.
   ------------------------------------------------------------ */
RACER.initDealersMap = function (containerId, geo, done) {
    if (!window.ymaps) return;
    ymaps.ready(function () {
        var map = new ymaps.Map(containerId, {
            center: [57.76, 83.64],
            zoom: 3,
            controls: ['zoomControl', 'fullscreenControl']
        }, {
            searchControlProvider: 'yandex#search'
        });
        var om = new ymaps.ObjectManager({ clusterize: false });
        om.objects.options.set({
            iconLayout: 'default#image',
            iconImageHref: '/assets/img/mapMarker.png?v2',
            iconImageSize: [30, 44],
            iconImageOffset: [-15, -44]
        });
        var g = JSON.parse(JSON.stringify(geo));
        (g.features || []).forEach(function (f) {
            f.geometry.coordinates = f.geometry.coordinates.map(Number);
        });
        om.add(g);
        map.geoObjects.add(om);
        if ((g.features || []).length) {
            map.setBounds(om.getBounds(), { checkZoomRange: true, zoomMargin: 30 });
        }

        var $wrap = $('#' + containerId).parent();
        om.objects.events.add('click', function (e) {
            var obj = om.objects.getById(e.get('objectId'));
            RACER.showMapInfo($wrap, (obj && obj.data) || {});
        });

        if (done) done(map, om);
    });
};

/* Показать инфо-блок точки внутри обёртки карты. */
RACER.showMapInfo = function ($wrap, d) {
    var $info = $wrap.find('.map-info');
    if (!$info.length) return;
    $info.find('.map-info-name').text(RACER.unesc(d.name || ''));
    $info.find('.map-info-adres').text(d.adres || '');
    $info.find('.map-info-phone').text(d.phone ? 'тел: ' + d.phone : '');
    var $site = $info.find('.map-info-site');
    if (d.site) {
        $site.attr('href', d.site).css('display', 'flex');
    } else {
        $site.attr('href', '#').css('display', 'none');
    }
    $info.addClass('is-open');
};

$(document).on('click', '.map-info-close', function () {
    $(this).closest('.map-info').removeClass('is-open');
});

